# --- Core ---
APP_ENV=production
BASE_URL=https://getplantpal.com
# DB_PATH / IMAGE_DIR are intentionally NOT set here: the Docker image already
# defaults them to /data (the persisted, Litestream-backed volume). Only set them
# for local non-Docker dev, e.g. DB_PATH=data/plantpal.db / IMAGE_DIR=data/images.

# --- Secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
TOKEN_PEPPER=change-me-please-long-random
CSRF_SECRET=change-me-too-long-random

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=PlantPal <gruss@getplantpal.com>

# --- Optional overrides (defaults shown) ---
# SESSION_SOFT_CAP_DAYS=90
# SESSION_HARD_CAP_DAYS=180
# LOGIN_TOKEN_TTL_MIN=30
# INVITE_TOKEN_TTL_DAYS=14
# REMINDER_HOUR_BERLIN=8
# IMG_SIZE_PX=96
# IMG_MAX_UPLOAD_MB=10

# --- Cloudflare Tunnel (public ingress, no open router ports) ---
# Create a tunnel in the Cloudflare dashboard, route getplantpal.com -> http://plantpal:8000,
# then paste the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backup (scripts/backup.sh via host cron; K5) ---
# PLANTPAL_BACKUP_DEST=/backup/plantpal
# PLANTPAL_BACKUP_RSYNC=user@host:/remote/plantpal

# --- v3 optional overrides (defaults shown) ---
# HK_HOUR_BERLIN=3            # nightly housekeeping hour
# LOGIN_CODE_TTL_MIN=10  LOGIN_CODE_MAX_ATTEMPTS=5
# EMAIL_CHANGE_TTL_MIN=30  APP_VERSION=3.0.0  LOG_LEVEL=INFO

# --- Apple App Review (nur während eines Review-Fensters setzen!) ---
# Komma-Liste: Haupt- + Reserve-Account (Lösch-Test). Code MUSS 6 Ziffern sein.
# REVIEW_CODE_EXPIRES_AT deaktiviert den Pfad automatisch (ISO, Berlin-Zeit).
# Nach dem Review: alle drei leeren + Accounts deprovisionieren.
# REVIEW_ACCOUNT_EMAIL=review@getplantpal.com, review2@getplantpal.com
# REVIEW_LOGIN_CODE=734291
# REVIEW_CODE_EXPIRES_AT=2026-07-15 00:00:00

# --- Native App-Shell (Capacitor iOS): exakte Origins, Komma-Liste ---
# Aktiviert CORS + Origin-Allowlist für die App. Web-only: leer lassen.
# ALLOWED_APP_ORIGINS=capacitor://localhost

# --- Litestream backup (optional, alternative to scripts/backup.sh) ---
LITESTREAM_ENABLED=false
# LITESTREAM_REPLICA_URL=s3://your-bucket/plantpal
