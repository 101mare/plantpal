# --- Core ---
APP_ENV=production
BASE_URL=https://plantpal.example.com
# DB_PATH / IMAGE_DIR are intentionally NOT set here: the Docker image already
# defaults them to /data (the persisted, Litestream-backed volume). Only set them
# for local non-Docker dev, e.g. DB_PATH=data/plantpal.db / IMAGE_DIR=data/images.

# --- Secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
TOKEN_PEPPER=change-me-please-long-random
CSRF_SECRET=change-me-too-long-random

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=PlantPal <noreply@plantpal.example.com>

# --- Optional overrides (defaults shown) ---
# SESSION_SOFT_CAP_DAYS=90
# SESSION_HARD_CAP_DAYS=180
# LOGIN_TOKEN_TTL_MIN=30
# INVITE_TOKEN_TTL_DAYS=14
# REMINDER_HOUR_BERLIN=8
# IMG_SIZE_PX=96
# IMG_MAX_UPLOAD_MB=10

# --- Litestream backup (optional) ---
LITESTREAM_ENABLED=false
# LITESTREAM_REPLICA_URL=s3://your-bucket/plantpal
